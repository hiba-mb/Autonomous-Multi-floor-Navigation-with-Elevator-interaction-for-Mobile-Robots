<?xml version="1.0"?>
<robot name="jackal" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:arg name="robot_ns" default="robot1"/>
  <!-- Base dimensions -->
  <xacro:property name="base_x_size" value="0.508"/>
  <xacro:property name="base_y_size" value="0.430"/>
  <xacro:property name="base_z_size" value="0.210"/>
  <xacro:property name="wheel_radius" value="0.098"/>
  <xacro:property name="wheel_width" value="0.040"/>
  <xacro:property name="wheelbase" value="0.262"/>
  <xacro:property name="track" value="0.370"/>

  <!-- Materials -->
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="light_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="yellow"><color rgba="0.8 0.8 0.0 1.0"/></material>
  <material name="black"><color rgba="0.15 0.15 0.15 1.0"/></material>

  <!-- Base link -->
  <link name="base_link"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base_footprint"/>

  <!-- Chassis -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="chassis_link">
    <inertial>
      <mass value="16.523"/>
      <origin xyz="-0.08748 0 0.09" rpy="0 0 0"/>
      <inertia ixx="0.3136" ixy="0" ixz="0" iyy="0.4738" iyz="0" izz="0.5358"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
      </geometry>
    </collision>
  </link>

  <!-- Front bumper -->
  <joint name="front_bumper_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="front_bumper_link"/>
    <origin xyz="0.28 0 0.09" rpy="0 0 0"/>
  </joint>
  <link name="front_bumper_link">
    <visual>
      <geometry><box size="0.02 0.43 0.21"/></geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <!-- Rear bumper -->
  <joint name="rear_bumper_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="rear_bumper_link"/>
    <origin xyz="-0.28 0 0.09" rpy="0 0 0"/>
  </joint>
  <link name="rear_bumper_link">
    <visual>
      <geometry><box size="0.02 0.43 0.21"/></geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <!-- Wheels -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="chassis_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect * wheelbase} ${y_reflect * track / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${prefix}_wheel_link">
      <inertial>
        <mass value="0.477"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0013" ixy="0" ixz="0" iyy="0.0024" iyz="0" izz="0.0013"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

  <!-- IMU -->
  <joint name="imu_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.19 0 0.149" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <!-- Front laser -->
  <joint name="front_laser_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="front_laser"/>
    <origin xyz="0.23 0 0.225" rpy="0 0 0"/>
  </joint>
  <link name="front_laser">
    <visual>
      <geometry><cylinder radius="0.04" length="0.07"/></geometry>
      <material name="light_grey"/>
    </visual>
  </link>

  <!-- Gazebo plugins -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>$(arg robot_ns)/cmd_vel</topic>
      <odom_topic>$(arg robot_ns)/odometry/filtered</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>$(arg robot_ns)/odom</frame_id>
      <child_frame_id>$(arg robot_ns)/base_link</child_frame_id>
      <min_velocity>-3</min_velocity>
      <max_velocity>3</max_velocity>
      <min_acceleration>-7</min_acceleration>
      <max_acceleration>7</max_acceleration>
      <min_linear_velocity>-2.0</min_linear_velocity>    <!-- Augmenté de 0.8 à 2.0 -->
      <max_linear_velocity>2.0</max_linear_velocity>     <!-- Augmenté de 0.8 à 2.0 -->
      <min_angular_velocity>-2.5</min_angular_velocity>  <!-- Augmenté de 0.8 à 2.5 rad/s -->
      <max_angular_velocity>2.5</max_angular_velocity> 
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>$(arg robot_ns)/joint_states</topic>
    </plugin> 
 </gazebo>

  <!-- ✅ CORRIGÉ -->
<gazebo reference="front_laser">
  <sensor name="front_laser" type="gpu_lidar">
    <topic>$(arg robot_ns)/front/scan</topic>
    <update_rate>5</update_rate>
    <lidar>
      <scan>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-2.617</min_angle>
          <max_angle>2.617</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.08</min>
        <max>30.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </lidar>
    <always_on>1</always_on>
    <visualize>true</visualize>
  </sensor>
</gazebo>

  <!-- IMU sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu/data</topic>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- Wheel friction -->
  <gazebo reference="front_left_wheel_link">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>

</robot>