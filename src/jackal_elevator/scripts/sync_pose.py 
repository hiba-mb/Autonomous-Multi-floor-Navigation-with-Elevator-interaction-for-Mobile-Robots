#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from nav_msgs.msg import Odometry
from geometry_msgs.msg import PoseWithCovarianceStamped

class SimplePoseSync(Node):
    def __init__(self):
        super().__init__('simple_pose_sync')
        
        # Publie la pose pour AMCL
        self.pose_pub = self.create_publisher(PoseWithCovarianceStamped, '/initialpose', 10)
        
        # Lit la position réelle du robot
        self.odom_sub = self.create_subscription(
            Odometry, 
            '/odometry/filtered',
            self.odom_callback, 
            10
        )
        
        self.get_logger().info("✅ Synchronisation activée - AMCL suit /odom")
    
    def odom_callback(self, msg):
