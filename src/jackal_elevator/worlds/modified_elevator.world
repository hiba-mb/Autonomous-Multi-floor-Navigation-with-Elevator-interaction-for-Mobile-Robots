      <link name='door'>
        <pose>1.0745 -0.5 1.125 0 -0 0</pose>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.08 1 2.25</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
